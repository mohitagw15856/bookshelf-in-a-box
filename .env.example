# bookshelf-in-a-box configuration
# Copy this file to ".env" (setup.sh / setup.ps1 does this for you)
# and adjust the values below if you like.

# Your timezone in "Region/City" format.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# The port the library is served on. Visit http://localhost:<PORT>
# Change this only if 8083 is already used by something else.
PORT=8083

# User / group IDs the container runs as. 1000 is the first normal
# user on most Linux systems and on Raspberry Pi OS. Leave these alone
# unless you know you need something different (setup.sh sets them for you).
PUID=1000
PGID=1000

# Set to "true" ONLY if your library lives on a network share
# (NAS / SMB / NFS mount). See the README troubleshooting section.
NETWORK_SHARE_MODE=false

# If new books on a network share aren't being picked up, set this to
# "poll" to switch the folder watcher to reliable polling mode.
# Leave blank for the default (fast, local-disk) behaviour.
CWA_WATCH_MODE=

# ── Optional: richer metadata ──────────────────────────────────────────────
# A free Hardcover.app API token lets the server auto-fetch covers and
# metadata for imported books. Get one at https://hardcover.app (Account →
# API). Leave blank to skip.
HARDCOVER_TOKEN=

# ── Optional: automatic nightly backups (docker-compose.backup.yml) ─────────
# When to run (cron format) and how many backups to keep.
BACKUP_CRON=0 3 * * *
BACKUP_KEEP=7

# ── Optional: read from anywhere with Tailscale (docker-compose.tailscale.yml)
# Create a free key at https://login.tailscale.com/admin/settings/keys
# Leave blank to grab a login link from the container logs instead.
TS_AUTHKEY=
TS_HOSTNAME=bookshelf

# ── Optional: HTTPS via Caddy (docker-compose.caddy.yml) ────────────────────
# The hostname Caddy serves on your LAN.
CADDY_HOST=bookshelf.local
