# bookshelf-in-a-box configuration
# Copy this file to ".env" (setup.sh / setup.ps1 does this for you)
# and adjust the values below if you like.

# Your timezone in "Region/City" format.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# The port the library is served on. Visit http://localhost:<PORT>
# Change this only if 8083 is already used by something else.
PORT=8083

# User / group IDs the container runs as. 1000 is the first normal
# user on most Linux systems and on Raspberry Pi OS. Leave these alone
# unless you know you need something different (setup.sh sets them for you).
PUID=1000
PGID=1000

# Set to "true" ONLY if your library lives on a network share
# (NAS / SMB / NFS mount). See the README troubleshooting section.
NETWORK_SHARE_MODE=false
