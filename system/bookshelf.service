# bookshelf-in-a-box — systemd unit (reference template)
#
# You normally install this with:
#     sudo ./scripts/install-service.sh
# which fills in the correct paths and user for your machine automatically.
#
# This file is only a reference. To use it by hand, edit WorkingDirectory,
# User, and the docker path, then copy it to /etc/systemd/system/ and run:
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now bookshelf.service

[Unit]
Description=bookshelf-in-a-box (self-hosted ebook library)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/bookshelf-in-a-box
User=pi
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
